# Required: your OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Optional
# OPENROUTER_MODEL=anthropic/claude-opus-5.5            # model that writes the brochure
# OPENROUTER_RESEARCH_MODEL=anthropic/claude-opus-5.5   # model that researches (defaults to OPENROUTER_MODEL)
# OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5       # profile search + fact check
# PORT=4580
# TWAI_CONTACT_EMAIL=          # shows an "Email us" button on brochures when set
# TWAI_BOOKING_URL=            # defaults to the Calendly discovery-call link
# BROWSER_PATH=                # Chrome/Edge for PDF export (auto-detected)
